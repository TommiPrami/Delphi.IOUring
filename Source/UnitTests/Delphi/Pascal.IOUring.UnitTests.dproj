        <DCCReference Include="..\..\Units\PIRUnit.BlockReader.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Test.FileHelpers.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Test.PlatformHelpers.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Test.Support.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Test.FileHelpers.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Windows.API.Layout.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Windows.API.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.IORing.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.SequentialReader.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Streams.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Atomics.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.RequestPool.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.RequestQueue.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.Engine.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.BlockReader.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.EngineOverlap.Tests.pas"/>
        <DCCReference Include="..\Common\PIRUnit.SequentialWriter.Tests.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
